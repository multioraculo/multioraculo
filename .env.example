# Copie para .env.local (desenvolvimento) ou defina no painel do Netlify.

# OpenAI — interpretação dos oráculos (gpt-4o-mini) e síntese (gpt-4o)
OPENAI_API_KEY=

# Supabase — autenticação e leituras salvas
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: índice de trechos dos PDFs. Se ausente, o app usa
# data/pdfs_index/pdfs.index.json localmente ou baixa da release no GitHub.
# PDFS_INDEX_URL=https://github.com/multioraculo/multioraculo/releases/download/v1-data/pdfs.index.json
