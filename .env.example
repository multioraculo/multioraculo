# Copie para .env.local (desenvolvimento) ou defina no painel do Netlify.
# NUNCA commite valores reais.

# OpenAI — interpretação dos oráculos (gpt-4o-mini) e síntese (gpt-4o)
OPENAI_API_KEY=

# Supabase — autenticação e leituras salvas (públicas: vão ao navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role (SÓ servidor). Necessária para o webhook da Stripe
# gravar assinaturas e para o registro/contagem de tiragens ignorar o RLS.
# Sem ela, em produção as consultas ficam bloqueadas (fail-closed).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (SÓ servidor)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs dos prices recorrentes criados manualmente no Dashboard (price_...)
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_ILIMITADO=

# URL pública do site, usada nas URLs de retorno do Checkout/Portal.
# Opcional: sem ela, a rota usa o host da requisição.
NEXT_PUBLIC_SITE_URL=https://multioraculo.com

# Opcional: índice de trechos dos PDFs. Se ausente, o app usa
# data/pdfs_index/pdfs.index.json localmente ou baixa da release no GitHub.
# PDFS_INDEX_URL=https://github.com/multioraculo/multioraculo/releases/download/v1-data/pdfs.index.json
